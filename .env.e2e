# Config de build usada SÓ por `pnpm e2e` (electron-vite --mode e2e). Valores falsos, sem segredo:
# o E2E simula o intermediário e o Notion dentro do processo main.
MAIN_VITE_NOTION_OAUTH_CLIENT_ID=e2e-client-id
# Site do Orkio (intermediário do Notion em /notion/*, revisão em /github/*), simulado no main.
MAIN_VITE_SITE_URL=https://orkio-oauth-broker.e2e.invalid

# GitHub OAuth App (Device Flow) falsa para o E2E.
MAIN_VITE_GITHUB_CLIENT_ID=e2e-github-client
