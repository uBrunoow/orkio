# Copie para `.env` (dev/build local) ou `.env.production` (build de release).
# Nenhum destes valores é segredo. O client SECRET fica só no intermediário (site/, na Vercel).

# OAuth client ID da conexão do Notion (developers.notion.com → sua conexão OAuth).
MAIN_VITE_NOTION_OAUTH_CLIENT_ID=

# Client ID da OAuth App do GitHub com "Enable Device Flow" ligado (público; sem client secret).
MAIN_VITE_GITHUB_CLIENT_ID=

# Endereço do site do Orkio, ex.: https://<domínio do site>. É o único endereço do site no app:
# intermediário OAuth do Notion (/notion/*), revisão como orkio[bot] e GitHub App (/github/*) e os
# links de Configurações > Sobre. Em dev, com o site local (`pnpm --dir site dev`):
# http://127.0.0.1:3000 (http só em 127.0.0.1 e nunca no build de produção).
MAIN_VITE_SITE_URL=
