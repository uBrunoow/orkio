{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node"],
    // scripts/*.mts rodam direto no Node (só tipos para tirar): importam outros .mts pelo nome real.
    "allowImportingTsExtensions": true
  },
  "include": [
    "electron.vite.config.ts",
    "electron-builder.ts",
    "vitest.config.mts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "scripts/**/*.mts",
    "test/**/*"
  ]
}
