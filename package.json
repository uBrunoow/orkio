{
  "name": "orkio",
  "version": "0.2.3",
  "private": true,
  "description": "Orkio — orquestração de desenvolvimento com IA (Notion, GitHub, Claude Code).",
  "author": "Orkio",
  "homepage": "https://github.com/uBrunoow/orkio",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "predev": "node scripts/dev-desktop-entry.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web && pnpm typecheck:e2e && pnpm typecheck:broker",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "icons": "node scripts/generate-icons.mjs",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "e2e": "electron-vite build --mode e2e && playwright test",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:broker": "tsc --noEmit -p tsconfig.broker.json",
    "release": "node scripts/release.mjs",
    "smoke:packaged": "playwright test -c e2e-packaged/playwright.config.ts",
    "astryx:static-css": "node scripts/generate-astryx-static-css.mjs"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.16",
    "@astryxdesign/core": "0.7.16",
    "@astryxdesign/theme-neutral": "0.7.16",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@playwright/test": "~1.65.1",
    "@stylexjs/stylex": "^0.19.2",
    "@tabler/icons-react": "^3.52.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "png2icons": "^2.0.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
