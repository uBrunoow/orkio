#!/usr/bin/env node
/* eslint-disable */
/**
 * Claude Code SIMULADO para o E2E (nunca chamamos o CLI real no CI).
 *
 * - `claude --version` / `claude auth status`: login lido de `auth.json` ao lado deste arquivo.
 * - `claude -p ... --mcp-config <arquivo>`: emite stream-json, edita arquivos no cwd (worktree),
 *   e pede permissões pela ponte MCP REAL do Orkio (o mesmo `permission-mcp.js` do app).
 *
 * O cenário vem de palavras no prompt: "pedir-shell", "tentar-push", "perguntar", "demorar", "demorar-uma-vez",
 * "ler-env".
 */
const { spawn, execFileSync } = require('node:child_process')
const { mkdirSync, readFileSync, writeFileSync, existsSync } = require('node:fs')
const { join } = require('node:path')
const readline = require('node:readline')

const args = process.argv.slice(2)
const authFile = join(__dirname, 'auth.json')

if (args[0] === '--version') {
  process.stdout.write('2.1.9 (Claude Code)\n')
  process.exit(0)
}
if (args[0] === 'mcp' && args[1] === 'list') {
  // Só o MCP do Backlog importa para a pré-checagem do alva-flow (escopo do usuário).
  const cfgFile = join(__dirname, 'mcp.json')
  const cfg = existsSync(cfgFile) ? JSON.parse(readFileSync(cfgFile, 'utf8')) : {}
  process.stdout.write('Checking MCP server health...\n\n')
  if (cfg.backlog) process.stdout.write('backlog: backlog mcp start - ✔ Connected\n')
  else process.stdout.write('No MCP servers configured.\n')
  process.exit(0)
}
if (args[0] === 'auth' && args[1] === 'status') {
  const auth = existsSync(authFile)
    ? JSON.parse(readFileSync(authFile, 'utf8'))
    : { loggedIn: true, authMethod: 'claude.ai' }
  process.stdout.write(JSON.stringify({ ...auth, email: 'nao-mostrar@example.com' }) + '\n')
  process.exit(auth.loggedIn ? 0 : 1)
}

const out = (msg) => process.stdout.write(JSON.stringify(msg) + '\n')
const sleep = (ms) => new Promise((r) => setTimeout(r, ms))
let turns = 0
const assistant = (content) => {
  turns++
  out({ type: 'assistant', parent_tool_use_id: null, message: { role: 'assistant', content } })
}
const toolResult = (id, isError) =>
  out({
    type: 'user',
    message: {
      role: 'user',
      content: [{ type: 'tool_result', tool_use_id: id, is_error: isError, content: 'x' }]
    }
  })

/** Cliente MCP mínimo para a ponte do Orkio. */
function bridge(config) {
  const server = config.mcpServers.orkio
  const child = spawn(server.command, server.args, {
    env: { ...process.env, ...server.env },
    stdio: ['pipe', 'pipe', 'inherit']
  })
  const waiting = new Map()
  readline.createInterface({ input: child.stdout }).on('line', (line) => {
    const msg = JSON.parse(line)
    waiting.get(msg.id)?.(msg)
    waiting.delete(msg.id)
  })
  let next = 1
  const request = (method, params) =>
    new Promise((resolve) => {
      const id = next++
      waiting.set(id, resolve)
      child.stdin.write(JSON.stringify({ jsonrpc: '2.0', id, method, params }) + '\n')
    })
  return {
    init: () => request('initialize', { protocolVersion: '2025-06-18', capabilities: {} }),
    async approve(toolName, input, toolUseId) {
      const res = await request('tools/call', {
        name: 'approve',
        arguments: { tool_name: toolName, input, tool_use_id: toolUseId }
      })
      return JSON.parse(res.result.content[0].text)
    },
    close: () => child.kill()
  }
}

async function main() {
  const configPath = args[args.indexOf('--mcp-config') + 1]
  const config = JSON.parse(readFileSync(configPath, 'utf8'))
  let killed = false
  process.on('SIGINT', () => {
    killed = true
    process.exit(130)
  })

  const first = await new Promise((resolve) => {
    readline.createInterface({ input: process.stdin }).once('line', resolve)
  })
  const prompt = JSON.parse(first).message.content[0].text

  // 8A: registra o que o agente recebeu (system prompt extra e modelo), para o E2E conferir.
  {
    const orkioDir = join(process.cwd(), '.orkio')
    mkdirSync(orkioDir, { recursive: true })
    const flag = (name) => (args.includes(name) ? args[args.indexOf(name) + 1] : null)
    require('node:fs').appendFileSync(
      join(orkioDir, 'agent-args.log'),
      JSON.stringify({
        appendSystemPrompt: flag('--append-system-prompt'),
        model: flag('--model'),
        briefingInPrompt: prompt.includes('Briefing da tarefa'),
        permissionTool: flag('--permission-prompt-tool'),
        permissionMode: flag('--permission-mode')
      }) + '\n'
    )
  }

  out({
    type: 'system',
    subtype: 'init',
    model: 'claude-simulado',
    cwd: process.cwd(),
    slash_commands: ['revisar', 'spec'],
    plugins: [{ name: 'plugin-simulado', path: '/x' }]
  })
  const leaked = ['ANTHROPIC_API_KEY', 'CLAUDE_CODE_OAUTH_TOKEN'].filter((k) => process.env[k])
  assistant([
    {
      type: 'text',
      text: leaked.length
        ? `VAZOU: ${leaked.join(',')}`
        : `Li o briefing (${prompt.includes('Critérios de aceite') ? 'com critérios' : 'sem critérios'}).`
    }
  ])

  if (prompt.includes('falhar')) {
    process.stderr.write('falha simulada\n')
    process.exit(1)
  }

  const mcp = bridge(config)
  await mcp.init()

  // alva-flow simulado: imita o efeito dos comandos no Backlog.md (backlog/tasks/).
  const alvaMatch = /^\/alva-flow:(\w+)\s*([^\n]*)/.exec(prompt)
  if (alvaMatch) {
    await alvaCommand(alvaMatch[1], alvaMatch[2].trim(), mcp, prompt)
    return
  }

  // Edição dentro do worktree (acceptEdits: não passa pela ponte).
  mkdirSync(join(process.cwd(), 'src'), { recursive: true })
  writeFileSync(join(process.cwd(), 'src', 'exportar.ts'), 'export const csv = true\n')
  assistant([
    {
      type: 'tool_use',
      id: 'toolu_edit',
      name: 'Write',
      input: { file_path: join(process.cwd(), 'src', 'exportar.ts'), content: 'x' }
    }
  ])
  toolResult('toolu_edit', false)

  if (prompt.includes('escrever-doc')) {
    mkdirSync(join(process.cwd(), 'docs'), { recursive: true })
    writeFileSync(
      join(process.cwd(), 'docs', 'exportar.md'),
      '# Exportar CSV\n\n## Decisões\n\nSeparador ponto e vírgula. TOKEN=ghp_abcdefghijklmnopqrstuvwxyz0123\n'
    )
    assistant([
      {
        type: 'tool_use',
        id: 'toolu_doc',
        name: 'Write',
        input: { file_path: join(process.cwd(), 'docs', 'exportar.md'), content: 'x' }
      }
    ])
    toolResult('toolu_doc', false)
  }

  if (prompt.includes('ler-env')) {
    writeFileSync(join(process.cwd(), '.env'), 'SEGREDO_E2E=valor-super-secreto-123\n')
    assistant([
      {
        type: 'tool_use',
        id: 'toolu_env',
        name: 'Read',
        input: { file_path: join(process.cwd(), '.env') }
      }
    ])
    toolResult('toolu_env', false)
    assistant([
      {
        type: 'text',
        text: 'Achei SEGREDO_E2E=valor-super-secreto-123 e sk-ant-api03-abcdefghijklmnopqrstuvwxyz'
      }
    ])
  }

  if (prompt.includes('tentar-push')) {
    const r = await mcp.approve('Bash', { command: 'git push origin HEAD' }, 'toolu_push')
    assistant([{ type: 'text', text: `push: ${r.behavior}` }])
    const o = await mcp.approve('Write', { file_path: '/etc/orkio-fora.txt' }, 'toolu_out')
    assistant([{ type: 'text', text: `fora: ${o.behavior}` }])
  }

  if (prompt.includes('pedir-shell')) {
    const r = await mcp.approve('Bash', { command: 'npm test' }, 'toolu_shell')
    assistant([
      { type: 'tool_use', id: 'toolu_shell', name: 'Bash', input: { command: 'npm test' } }
    ])
    toolResult('toolu_shell', r.behavior !== 'allow')
    assistant([{ type: 'text', text: `shell: ${r.behavior}` }])
  }

  if (prompt.includes('perguntar')) {
    const input = {
      questions: [
        {
          question: 'Qual separador usar?',
          header: 'CSV',
          options: [{ label: 'Vírgula' }, { label: 'Ponto e vírgula' }],
          multiSelect: false
        }
      ]
    }
    const r = await mcp.approve('AskUserQuestion', input, 'toolu_q')
    const answer =
      r.updatedInput && r.updatedInput.answers
        ? Object.values(r.updatedInput.answers).join(',')
        : 'nenhuma'
    assistant([{ type: 'text', text: `resposta: ${answer}` }])
  }

  if (prompt.includes('demorar-uma-vez')) {
    // Espera só na primeira vez (marcador no worktree): para testar fechar o app e retomar.
    const marker = join(process.cwd(), '.orkio', 'demorou')
    if (!existsSync(marker)) {
      mkdirSync(join(process.cwd(), '.orkio'), { recursive: true })
      writeFileSync(marker, 'x')
      assistant([{ type: 'text', text: 'Primeira vez: trabalhando por um bom tempo…' }])
      while (!killed) await sleep(200)
    }
  } else if (prompt.includes('demorar')) {
    assistant([{ type: 'text', text: 'Trabalhando por um bom tempo…' }])
    while (!killed) await sleep(200)
  }

  execFileSync('git', ['add', '-A'], { cwd: process.cwd() })
  execFileSync(
    'git',
    [
      '-c',
      'user.name=Fake',
      '-c',
      'user.email=fake@example.com',
      'commit',
      '--allow-empty',
      '-q',
      '-m',
      'feat: exportar CSV (simulado)'
    ],
    { cwd: process.cwd() }
  )
  mcp.close()
  out({
    type: 'result',
    subtype: 'success',
    is_error: false,
    duration_ms: 1234,
    total_cost_usd: 0.0123,
    num_turns: turns,
    result: 'Pronto: exportação implementada.'
  })
  // O Orkio fecha a entrada após o result; o CLI termina.
  process.stdin.on('end', () => process.exit(0))
  setTimeout(() => process.exit(0), 2000)
}

/** Imitação mínima do plugin alva-flow para o E2E (nunca o plugin real). */
async function alvaCommand(cmd, argsText, mcp, prompt) {
  const cwd = process.cwd()
  const tasksDir = join(cwd, 'backlog', 'tasks')
  const orkioDir = join(cwd, '.orkio')
  mkdirSync(orkioDir, { recursive: true })
  // Registro do que cada comando recebeu (fica fora do git: .orkio/.gitignore = *).
  require('node:fs').appendFileSync(join(orkioDir, 'alva-args.log'), `${cmd} ${argsText}\n`)
  const taskFile = () => {
    const f = require('node:fs')
      .readdirSync(tasksDir)
      .find((n) => /^task-1 - /.test(n))
    return f ? join(tasksDir, f) : null
  }
  const setStatus = (status) => {
    const f = taskFile()
    writeFileSync(f, readFileSync(f, 'utf8').replace(/^status: .*$/m, `status: ${status}`))
  }
  let result = 'Pronto.'
  if (cmd === 'spec') {
    if (!/^TASK-\d+/.test(argsText)) {
      // Perguntas em lote (como o /spec faz com o PO).
      const r = await mcp.approve(
        'AskUserQuestion',
        {
          questions: [
            {
              question: 'Qual o formato da exportação?',
              header: 'Formato',
              options: [{ label: 'CSV' }, { label: 'XLSX' }],
              multiSelect: false
            },
            {
              question: 'Quem pode exportar?',
              header: 'Acesso',
              options: [{ label: 'Todos' }, { label: 'Só admins' }],
              multiSelect: false
            }
          ]
        },
        'toolu_spec_q'
      )
      const answers = (r.updatedInput && r.updatedInput.answers) || {}
      mkdirSync(tasksDir, { recursive: true })
      writeFileSync(
        join(tasksDir, 'task-1 - Exportar-tarefas.md'),
        [
          '---',
          'id: TASK-1',
          "title: 'Exportar tarefas'",
          'status: Requirements Defined',
          'assignee: []',
          '---',
          '',
          '## Description',
          '',
          '<!-- SECTION:DESCRIPTION:BEGIN -->',
          '## Problema',
          argsText,
          '',
          '## Decisões',
          ...Object.entries(answers).map(([q, a]) => `- ${q} → ${a}`),
          '',
          '## Perguntas em aberto',
          '- [x] Formato → decidido',
          '<!-- SECTION:DESCRIPTION:END -->',
          '',
          '## Acceptance Criteria',
          '<!-- AC:BEGIN -->',
          '- [ ] #1 CA-F01: QUANDO exportar ENTÃO o sistema DEVE gerar o arquivo',
          '- [ ] #2 CA-F02: QUANDO não for admin ENTÃO o sistema DEVE negar',
          '<!-- AC:END -->',
          ''
        ].join('\n')
      )
      result =
        '## Spec pronta ✓\n**Task:** TASK-1 — Exportar tarefas  |  **CA-F:** 2  |  **Tamanho:** Médio'
    }
  } else if (cmd === 'plan') {
    setStatus('Architected')
    result = '## Plano pronto ✓'
  } else if (cmd === 'implement') {
    mkdirSync(join(cwd, 'src'), { recursive: true })
    writeFileSync(join(cwd, 'src', 'exportar.ts'), 'export const exportar = true\n')
    setStatus('Executed')
    // Como o /implement real: código em stage, sem commit.
    execFileSync('git', ['add', 'src', 'backlog'], { cwd })
  } else if (cmd === 'review') {
    const counter = join(orkioDir, 'reviews')
    const n = (existsSync(counter) ? Number(readFileSync(counter, 'utf8')) : 0) + 1
    writeFileSync(counter, String(n))
    const blockers = Number(process.env.FAKE_ALVA_BLOCKERS || '1')
    setStatus(n <= blockers ? 'Executed' : 'Reviewed')
    result = n <= blockers ? 'Blocker: falta validação.' : 'Review limpo.'
  } else if (cmd === 'fix') {
    writeFileSync(join(cwd, 'src', 'exportar.ts'), 'export const exportar = true // corrigido\n')
    execFileSync('git', ['add', 'src'], { cwd })
  } else if (cmd === 'pr') {
    // 5C: o /pr real usa git e gh; aqui pede cada comando pela ponte de permissões do Orkio,
    // roda os liberados (gh simulado no PATH; git push para o origin local) e registra tudo.
    const fs = require('node:fs')
    const log = (line) => fs.appendFileSync(join(orkioDir, 'alva-args.log'), `${line}\n`)
    // Ambiente que o Orkio passou ao CLI (para provar que nenhum token do Orkio vai junto).
    writeFileSync(join(orkioDir, 'env.txt'), Object.values(process.env).join('\n'))
    const branch = execFileSync('git', ['branch', '--show-current'], { cwd }).toString().trim()
    let n = 0
    const tryCmd = async (command, argv) => {
      const r = await mcp.approve('Bash', { command }, `toolu_pr_${++n}`)
      log(`${r.behavior}:${command}`)
      if (r.behavior === 'allow') {
        execFileSync(argv[0], argv.slice(1), { cwd, stdio: 'ignore', env: process.env })
      }
      return r.behavior
    }
    if (argsText.includes('--comments')) {
      writeFileSync(
        join(cwd, 'src', 'exportar.ts'),
        'export const exportar = true // corrigido, comentário tratado\n'
      )
      execFileSync('git', ['add', '-A'], { cwd })
      execFileSync(
        'git',
        [
          '-c',
          'user.name=Fake',
          '-c',
          'user.email=fake@example.com',
          'commit',
          '-q',
          '-m',
          'fix: comentários da revisão'
        ],
        { cwd }
      )
      await tryCmd(`git push origin ${branch}`, ['git', 'push', '-q', 'origin', branch])
      const query =
        'mutation { resolveReviewThread(input: {threadId: "thread-7-0"}) { thread { isResolved } } }'
      await tryCmd(`gh api graphql -f query='${query}'`, [
        'gh',
        'api',
        'graphql',
        '-f',
        `query=${query}`
      ])
      result = 'Comentários tratados.'
    } else {
      let ahead = 1
      try {
        ahead = Number(
          execFileSync('git', ['rev-list', '--count', `origin/${branch}..HEAD`], { cwd })
            .toString()
            .trim()
        )
      } catch {
        ahead = 1
      }
      if (ahead > 0)
        await tryCmd(`git push -u origin ${branch}`, ['git', 'push', '-q', '-u', 'origin', branch])
      // Tentativas que o Orkio precisa bloquear mesmo no modo entrega.
      await tryCmd('gh pr merge 7 --squash', ['gh', 'pr', 'merge', '7', '--squash'])
      await tryCmd('git push --force origin HEAD:main', [
        'git',
        'push',
        '--force',
        'origin',
        'HEAD:main'
      ])
      await tryCmd('gh pr create --fill --base main', [
        'gh',
        'pr',
        'create',
        '--fill',
        '--base',
        'main'
      ])
      await tryCmd('gh pr checks 7', ['gh', 'pr', 'checks', '7'])
      // O /pr acompanha o CI e pergunta se continua esperando.
      const q = await mcp.approve(
        'AskUserQuestion',
        {
          questions: [
            {
              question: 'O CI ainda está rodando. Continuar esperando?',
              header: 'CI',
              options: [{ label: 'Sim, esperar' }, { label: 'Não, parar aqui' }],
              multiSelect: false
            }
          ]
        },
        'toolu_pr_ci'
      )
      log(`ci:${JSON.stringify((q.updatedInput && q.updatedInput.answers) || {})}`)
      result = 'PR aberta: https://github.com/acme/orkio-app/pull/7'
    }
  } else if (cmd === 'commit') {
    execFileSync('git', ['add', '-A'], { cwd })
    execFileSync(
      'git',
      [
        '-c',
        'user.name=Fake',
        '-c',
        'user.email=fake@example.com',
        'commit',
        '--allow-empty',
        '-q',
        '-m',
        'feat: exportar tarefas'
      ],
      { cwd }
    )
  }
  mcp.close()
  out({
    type: 'result',
    subtype: 'success',
    is_error: false,
    duration_ms: 500,
    total_cost_usd: 0.01,
    num_turns: 1,
    result
  })
  void prompt
  process.stdin.on('end', () => process.exit(0))
  setTimeout(() => process.exit(0), 2000)
}

main().catch((e) => {
  process.stderr.write(String(e && e.message) + '\n')
  process.exit(1)
})
